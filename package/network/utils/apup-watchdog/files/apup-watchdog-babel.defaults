#!/bin/sh
# babeld runs under the watcher, not as a service of its own
/etc/init.d/babeld disable
# The mesh address moves from bat0 to lo: Babel announces it as a /32
if uci -q get network.bat0_ip >/dev/null; then
    uci set network.bat0_ip.device='lo'
    uci set network.bat0_ip.netmask='255.255.255.255'
    uci -q delete network.bat0_ip.gateway
    uci -q delete network.bat0_ip.dns
    uci -q delete network.bat0
    uci -q delete network.bat0_hardif
    uci commit network
fi
# The peer interfaces belong to no netifd network: the firewall zone of the mesh has to match them by name
if uci -q get firewall.bat_zone >/dev/null; then
    uci -q del_list firewall.bat_zone.network='bat0_hardif'
    # The mesh radio is not always the first one; an entry that matches no interface is harmless
    for phy in phy0 phy1 phy2 phy3; do
        uci -q del_list firewall.bat_zone.device="$phy-ap0.sta+"
        uci add_list firewall.bat_zone.device="$phy-ap0.sta+"
    done
    uci commit firewall
fi
